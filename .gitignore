# file di configurazione
.env
.env_*
!.env.example

# Ignora la cartella .git e .github
.github/*
!.github

# file temporanei
*.swp
tmp/*

# Dati dei volumi — non versionati (dati runtime, submodule separati)
volumes/*
!volumes/mysql_data/.gitkeep
!volumes/nginx/.gitkeep

# I file di configurazione IaC in volumes/ SONO versionati:
#   volumes/nginx/conf.d/   — configurazione Nginx

# file di log
*.log

# Prompt
PROMPT.md

