# =============================================================================
# .env.example — Template variabili d'ambiente per lo stack LEMP
#
# IaC: questo file è versionato nel repository ed è la fonte di verità
# di tutte le variabili richieste dallo stack.
#
# Utilizzo:
#   cp .env.example .env
#   # modifica .env con i valori reali
#
# ⚠️  Non committare mai il file .env (già in .gitignore).
# =============================================================================

# -----------------------------------------------------------------------------
# MariaDB — credenziali server
# -----------------------------------------------------------------------------
MYSQL_ROOT_PASSWORD=changeme
MYSQL_USER=lemp
MYSQL_PASSWORD=changeme
# Queste credenziali sono referenziate dai file .env_<slug> (DB_USER, DB_PASSWORD)

# -----------------------------------------------------------------------------
# Database per sito — IaC: ogni sito dichiara il proprio database.
#
# MYSQL_DATABASE è stata RIMOSSA: non supporta la gestione multi-database.
# I database vengono creati dagli script SQL per-app in:
#   volumes/<slug>/setup/mysql_<slug>/init.sql
# eseguiti automaticamente al primo avvio su datadir vuoto.
#
# Per aggiungere un nuovo sito:
#   1. Aggiungi una variabile DB_<SITO>=nome_db qui sotto
#   2. Aggiungi il corrispondente blocco CREATE DATABASE nello script di init
#   3. Committa entrambi i file nel repository
# -----------------------------------------------------------------------------
DB_IDEEINCUCINA=ideeincucina
DB_BLOG_FBLABS=blog_fblabs

# -----------------------------------------------------------------------------
# Webserver — credenziali admin applicazione
# -----------------------------------------------------------------------------
WEBSERVER_ADMIN_USERNAME=admin
WEBSERVER_ADMIN_PASSWORD=changeme

